# Variáveis de ambiente do Stokc
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório.

# ── Configuração do Flask ──
# Chave secreta usada para segurança de sessões Flask.
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte

# ── Modo de execução ──
# Use "development" para rodar localmente com debug.
# Use "production" no servidor publicado.
FLASK_ENV=development

# ── Porta (opcional) ──
# Porta em que o servidor Flask vai escutar. Padrão: 5000.
PORT=5000
